<?xml version="1.0" encoding="utf-8" ?>
<!-- 
    App.config for PRODUCTION Environment
    Copy this file and rename to App.config when deploying to production
    
    ⚠️ IMPORTANT: Update connection string with production server details!
-->
<configuration>
    <configSections>
    </configSections>
    
    <!-- Connection Strings for Production -->
    <connectionStrings>
        <!-- OPTION 1: Windows Authentication (Integrated Security) -->
        <add name="DentalClinicDB" 
             connectionString="Data Source=YOUR_PRODUCTION_SERVER;Initial Catalog=DentalClinicDB;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        
        <!-- OPTION 2: SQL Server Authentication (Username/Password) -->
        <!--
        <add name="DentalClinicDB" 
             connectionString="Data Source=YOUR_PRODUCTION_SERVER;Initial Catalog=DentalClinicDB;User ID=YOUR_USERNAME;Password=YOUR_PASSWORD;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>
    
    <!-- Application Settings for Production -->
    <appSettings>
        <add key="Environment" value="Production" />
        <add key="ActiveConnectionString" value="DentalClinicDB" />
        <add key="EnableLogging" value="true" />
        <add key="LogFilePath" value="D:\Logs\DentalClinic\application.log" />
        <add key="SessionTimeout" value="30" />
        
        <!-- Production settings -->
        <add key="ShowSqlQueries" value="false" />
        <add key="DetailedErrorMessages" value="false" />
        
        <!-- Email settings for notifications -->
        <add key="SmtpServer" value="smtp.yourcompany.com" />
        <add key="SmtpPort" value="587" />
        <add key="EmailFrom" value="noreply@dentalclinic.com" />
        <add key="AdminEmail" value="admin@dentalclinic.com" />
    </appSettings>
    
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
