<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    
    <!-- Connection Strings -->
    <connectionStrings>
        <!-- ✅ SQL SERVER 2019 - SHARED DATABASE -->
        <!-- Server connection (localhost) - use this on the server machine -->
        <add name="DentalClinicDB" connectionString="Data Source=10.167.62.185,1433;Initial Catalog=DentalClinicDB;User ID=ClinicUser;Password=Clinic@User2026;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
        
        <!-- Client connection (LAN) - use this on client machines -->
        <!-- Uncomment and use this connection string on client computers -->
        <!--
        <add name="DentalClinicDB" connectionString="Data Source=10.128.43.222,1433;Initial Catalog=DentalClinicDB;User ID=ClinicUser;Password=Clinic@User2026;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
        -->
        
        <!-- OLD: LocalDB connection - không dùng nữa -->
        <!--
        <add name="DentalClinicDB_LocalDB" 
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DentalClinicDB;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        -->
        
        <!-- Alternative connection string for different environments -->
        <!--
        <add name="DentalClinicDB_Production" 
             connectionString="Data Source=YOUR_SERVER;Initial Catalog=DentalClinicDB;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        -->
        
        <!-- Alternative: SQL Server with credentials -->
        <!--
        <add name="DentalClinicDB_Remote" 
             connectionString="Data Source=10.77.183.14,1433;Initial Catalog=DentalClinicDB;User ID=BacSi;Password=123456;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>
    
    <!-- Application Settings -->
    <appSettings>
        <!-- Environment: Development, Staging, Production -->
        <add key="Environment" value="Development" />
        
        <!-- Database connection name to use -->
        <add key="ActiveConnectionString" value="DentalClinicDB" />
        
        <!-- Enable/Disable logging -->
        <add key="EnableLogging" value="true" />
        
        <!-- Log file path -->
        <add key="LogFilePath" value="Logs\application.log" />
        
        <!-- Session timeout (minutes) -->
        <add key="SessionTimeout" value="30" />
        
        <!-- ========================================
             EMAIL CONFIGURATION (SMTP)
             ======================================== -->
        
        <!-- SMTP Server Settings -->
        <add key="SmtpHost" value="smtp.gmail.com" />
        <add key="SmtpPort" value="587" />
        <add key="SmtpEnableSsl" value="true" />
        
        <!-- SMTP Credentials (IMPORTANT: Change these!) -->
        <!-- For Gmail: Use App Password, not regular password -->
        <!-- Create App Password: https://myaccount.google.com/apppasswords -->
        <add key="SmtpUsername" value="your-email@gmail.com" />
        <add key="SmtpPassword" value="your-app-password-here" />
        
        <!-- Email From Address -->
        <add key="EmailFromAddress" value="your-email@gmail.com" />
        <add key="EmailFromName" value="Phong kham Nha khoa UTC2" />
        
        <!-- Enable/Disable Email Notifications -->
        <add key="EnableEmailNotifications" value="true" />
        
        <!-- Enable/Disable Email Reminders (24h before appointment) -->
        <add key="EnableEmailReminders" value="true" />
        
        <!-- Reminder send time (24-hour format, e.g., 08:00) -->
        <add key="ReminderSendTime" value="08:00" />
        
        <!-- ========================================
             APPOINTMENT SETTINGS
             ======================================== -->
        
        <!-- Maximum appointments per time slot -->
        <add key="MaxSlotsPerTime" value="4" />
        
        <!-- Slot duration in minutes -->
        <add key="SlotDurationMinutes" value="30" />
        
        <!-- Working hours -->
        <add key="WorkingHoursStart" value="08:00" />
        <add key="WorkingHoursEnd" value="18:00" />
        
        <!-- ========================================
             INVENTORY SETTINGS
             ======================================== -->
        
        <!-- Low stock threshold -->
        <add key="LowStockThreshold" value="10" />
        
        <!-- Enable auto-deduct inventory when prescribing -->
        <add key="EnableAutoInventoryDeduction" value="true" />
    </appSettings>
    
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
