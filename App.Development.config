<?xml version="1.0" encoding="utf-8" ?>
<!-- 
    App.config for DEVELOPMENT Environment
    Copy this file and rename to App.config when deploying to development
-->
<configuration>
    <configSections>
    </configSections>
    
    <!-- Connection Strings for Development -->
    <connectionStrings>
        <add name="DentalClinicDB" 
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DentalClinicDB;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    
    <!-- Application Settings for Development -->
    <appSettings>
        <add key="Environment" value="Development" />
        <add key="ActiveConnectionString" value="DentalClinicDB" />
        <add key="EnableLogging" value="true" />
        <add key="LogFilePath" value="Logs\dev-application.log" />
        <add key="SessionTimeout" value="60" />
        
        <!-- Debug settings -->
        <add key="ShowSqlQueries" value="true" />
        <add key="DetailedErrorMessages" value="true" />
    </appSettings>
    
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
